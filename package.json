{
  "name": "rstest-jest-compat",
  "version": "0.0.0",
  "description": "Run an existing Jest suite under Rstest without rewriting specs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmssd/rstest-jest-compat.git"
  },
  "exports": {
    ".": {
      "types": "./jest-compat.d.mts",
      "default": "./jest-compat.mjs"
    }
  },
  "files": [
    "jest-compat.mjs",
    "jest-compat.d.mts"
  ],
  "scripts": {
    "test": "npm test --prefix test"
  },
  "peerDependencies": {
    "@rstest/core": ">=0.11.0"
  }
}
